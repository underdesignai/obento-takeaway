generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model configuracion {
  id    Int    @id @default(autoincrement())
  clave String @unique @db.VarChar(100)
  valor String
}

model pedido_items {
  id              Int      @id @default(autoincrement())
  pedido_id       Int?
  dish_id         String   @db.VarChar(50)
  nombre          String   @db.VarChar(150)
  categoria       String?  @db.VarChar(50)
  porcion         String?  @db.VarChar(50)
  opcion          String?  @db.VarChar(100)
  precio_unitario Decimal  @db.Decimal(10, 2)
  cantidad        Int      @default(1)
  subtotal        Decimal  @db.Decimal(10, 2)
  notas           String?
  pedidos         pedidos? @relation(fields: [pedido_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([pedido_id], map: "idx_pedido_items_pedido_id")
}

model pedidos {
  id                       Int            @id @default(autoincrement())
  numero_pedido            String         @unique @db.VarChar(20)
  cliente_nombre           String         @db.VarChar(150)
  cliente_telefono         String         @db.VarChar(50)
  cliente_email            String?        @db.VarChar(150)
  tipo_entrega             String?        @default("recogida_local") @db.VarChar(50)
  hora_recogida            String?        @db.VarChar(50)
  notas                    String?
  metodo_pago              String         @db.VarChar(50)
  estado_pago              String         @default("pendiente") @db.VarChar(50)
  estado_pedido            String         @default("recibido") @db.VarChar(50)
  total                    Decimal        @db.Decimal(10, 2)
  stripe_session_id        String?        @db.VarChar(255)
  stripe_payment_intent_id String?        @db.VarChar(255)
  created_at               DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?      @default(now()) @db.Timestamptz(6)
  pedido_items             pedido_items[]

  @@index([created_at(sort: Desc)], map: "idx_pedidos_created_at")
  @@index([estado_pedido], map: "idx_pedidos_estado")
  @@index([estado_pago], map: "idx_pedidos_estado_pago")
}
